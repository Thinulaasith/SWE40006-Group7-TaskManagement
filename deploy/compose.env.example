# npm run docker:setup generates deploy/compose.env with random credentials.
# The generated PostgreSQL password is URL-safe. Do not commit real credentials.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
METRICS_TOKEN=replace-with-random-monitoring-token
FRONTEND_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
TRUST_PROXY=false
APP_PORT=8080
